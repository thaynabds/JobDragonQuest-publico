{
  "manifest_version": 3,
  "name": "JobDragonQuest: salvar vaga",
  "version": "0.8.1",
  "description": "Salva a vaga da página aberta no seu JobDragonQuest local. Gratuita, sem servidor de terceiros.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" }
  },
  "icons": { "16": "icone-16.png", "48": "icone-48.png", "128": "icone-128.png" },
  "options_page": "opcoes.html",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "optional_host_permissions": ["https://*/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" },
  "browser_specific_settings": { "gecko": { "id": "salvar-vaga@jobdragonquest.local", "strict_min_version": "121.0" } }
}
