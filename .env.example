# Copie para .env (ou rode scripts/configurar-local.sh, que gera os valores) e nunca versione o .env.

# Banco PostgreSQL
JOBFLY_DB_URL=jdbc:postgresql://127.0.0.1:5432/jobfly
JOBFLY_DB_USER=jobfly
JOBFLY_DB_PASSWORD=

# Segredo do JWT em Base64, 32 bytes ou mais: openssl rand -base64 32
JOBFLY_JWT_SECRET=

# Origem do painel web (CORS e conferência de Origin no refresh)
JOBFLY_ALLOWED_ORIGINS=http://localhost:5173

# false só em desenvolvimento local sem HTTPS
JOBFLY_SECURE_COOKIES=false

JOBFLY_PORT=8080
# 127.0.0.1 = só esta máquina. Use 0.0.0.0 apenas atrás de um proxy reverso com HTTPS.
JOBFLY_ADDRESS=127.0.0.1
