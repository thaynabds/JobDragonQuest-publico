{
  "name": "jobdragonquest-web",
  "private": true,
  "version": "0.8.1",
  "type": "module",
  "description": "Painel web do JobDragonQuest: perfis, fontes vigiadas, vagas, candidaturas e pendências.",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
