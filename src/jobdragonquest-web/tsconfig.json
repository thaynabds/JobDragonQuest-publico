{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    // TypeScript 7 confere imports só de efeito (noUncheckedSideEffectImports): vite/client declara os módulos .css.
    "types": ["vite/client", "vitest/globals", "node"],
    // O chat com a IA usa as mesmas ferramentas do servidor MCP. O zod vem sempre deste pacote: no CI do painel o
    // node_modules do MCP não existe.
    "paths": {
      "@mcp/*": ["../jobdragonquest-mcp/src/*"],
      "zod": ["./node_modules/zod"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
